# Copia este archivo a `.env` y ajusta los valores. No pongas secretos reales aquí.
#
# Docker Compose lee este `.env` de la raíz del repositorio y sustituye las
# variables de `compose.yaml`. Las marcadas como obligatorias no tienen valor por
# defecto: si faltan, `docker compose up` falla nombrando la que falta.

# --- Docker Compose ---
# El nombre del proyecto ya está fijado en `compose.yaml` como `sidequest`.
# Descoméntalo solo para levantar un segundo entorno aislado —otro worktree—,
# junto con puertos publicados distintos.
# COMPOSE_PROJECT_NAME=sidequest

# --- Aplicación (API y MCP) ---
NODE_ENV=development
# Nivel del registro de peticiones: fatal, error, warn, info, debug, trace o silent.
LOG_LEVEL=info
APP_HOST=0.0.0.0
APP_PORT=3000
# Puerto publicado en la máquina anfitriona. Cámbialo si el 3000 está ocupado.
APP_HOST_PORT=3000
APP_PUBLIC_URL=http://localhost:3000

# --- Panel web ---
# El panel se ejecuta con `pnpm dev` fuera de Compose; llega al panel servido en
# SQST-0009.
WEB_PORT=5173
WEB_PUBLIC_URL=http://localhost:5173

# --- MySQL ---
# `MYSQL_HOST` y `MYSQL_PORT` son la dirección dentro de la red de Compose: el
# nombre del servicio, nunca una IP. `MYSQL_HOST_PORT` es el puerto publicado
# hacia fuera, para las migraciones y la inspección desde la máquina anfitriona.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=3306
MYSQL_DATABASE=sidequest
MYSQL_USER=sidequest
MYSQL_PASSWORD=cambia-esta-contrasena
MYSQL_ROOT_PASSWORD=cambia-esta-contrasena-de-root
# Obligatoria. Dentro de Compose apunta al servicio; desde la máquina anfitriona
# sería `mysql://sidequest:...@127.0.0.1:3306/sidequest`.
DATABASE_URL=mysql://sidequest:cambia-esta-contrasena@mysql:3306/sidequest

# --- Firma del attempt_token (docs/especificacion.md §4.4) ---
# Obligatoria. Genera una con: openssl rand -hex 32
SIDEQUEST_ATTEMPT_SECRET=genera-un-secreto-largo-y-aleatorio
