# Copia este archivo a `.env` y ajusta los valores. No pongas secretos reales aquí.

# --- Aplicación (API y MCP) ---
NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
APP_PUBLIC_URL=http://localhost:3000

# --- Panel web ---
WEB_PORT=5173
WEB_PUBLIC_URL=http://localhost:5173

# --- MySQL ---
# Dentro de Docker Compose el host es el nombre del servicio; desde la máquina
# anfitriona, `localhost` y el puerto publicado.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=sidequest
MYSQL_USER=sidequest
MYSQL_PASSWORD=cambia-esta-contrasena
MYSQL_ROOT_PASSWORD=cambia-esta-contrasena-de-root
DATABASE_URL=mysql://sidequest:cambia-esta-contrasena@mysql:3306/sidequest

# --- Firma del attempt_token (docs/especificacion.md §4.4) ---
# Genera uno con: openssl rand -hex 32
SIDEQUEST_ATTEMPT_SECRET=genera-un-secreto-largo-y-aleatorio
