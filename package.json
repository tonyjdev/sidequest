{
  "name": "sidequest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Aplicación local que intercala preguntas de conocimiento general en el trabajo con un agente de IA",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel run dev",
    "build": "pnpm --recursive run build",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "typecheck": "tsc --noEmit && pnpm --recursive run typecheck",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "pnpm --filter @sidequest/app run db:migrate",
    "db:rollback": "pnpm --filter @sidequest/app run db:rollback",
    "db:seed": "pnpm --filter @sidequest/app run db:seed",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "catalog:",
    "typescript-eslint": "^8.69.0",
    "vitest": "catalog:"
  }
}
